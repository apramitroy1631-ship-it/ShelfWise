<?xml version="1.0" encoding="UTF-8"?>
<!--
  ShelfWise backend: parent build for all Java services.
  Each service is a module; shared versions and settings live here once.
  Build everything from this folder:  ./mvnw verify
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent pins compatible versions of every Spring/Reactor/test library. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.shelfwise</groupId>
    <artifactId>shelfwise-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ShelfWise backend</name>

    <modules>
        <module>core-service</module>
        <module>notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!--
                          Netty (used by WebFlux and R2DBC) opens a local Unix-domain socket on Windows.
                          Some managed laptops block those inside the user's temp folder, which fails with
                          "Unable to establish loopback connection". Creating them in the build folder
                          avoids that and is harmless on Linux/macOS and in CI.
                          Tests also run in UTC, like the services (see the Application classes).
                        -->
                        <argLine>-Djdk.net.unixdomain.tmpdir=${project.build.directory} -Duser.timezone=UTC</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
